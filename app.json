{
  "expo": {
    "name": "Overture OSM Extractor",
    "slug": "mobileiosovertureextract",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spacialglacierlab.mobileiosovertureextract",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to center the map on your position.",
        "NSLocationAlwaysUsageDescription": "We need your location to center the map on your position.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "package": "com.spacialglacierlab.mobileiosovertureextract"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "@maplibre/maplibre-react-native",
        {
          "RNMaplibreIOSVersion": "6.8.1"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "extraPods": [
              {
                "name": "MapLibre",
                "version": "6.8.1"
              }
            ]
          }
        }
      ],
      "./plugins/withSuppressWarnings",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b16ba305-e0ba-428c-b097-11287fcd16c1"
      }
    },
    "owner": "777creative"
  }
}
